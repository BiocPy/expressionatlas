# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=expression-atlas-converter

# For local development only (App Runner/ECS uses IAM role)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Optional: API key for public service auth (if not using IAM)
# CONVERTER_API_KEY=your-secret-api-key

# Presigned URL expiry in minutes
SIGNED_URL_EXPIRY_MINUTES=60

# Max RData file size in MB
MAX_RDATA_SIZE_MB=500

# Converter service URL (for Python client)
CONVERTER_URL=https://your-service.us-east-1.awsapprunner.com
